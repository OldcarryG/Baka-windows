<Project Sdk="Microsoft.NET.Sdk">

  <!-- BAKA Desktop: the BAKA menu bar, dock, Launchpad, Files, Settings, Control Center and widgets.
       .NET Framework 4.8 ships inside every Windows 10/11, so the desktop needs no runtime install,
       starts from the pre-compiled framework and stays small. Modern C# still compiles for it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BakaDesktop</AssemblyName>
    <RootNamespace>Baka.Desktop</RootNamespace>
    <Version>12.27.1</Version>
    <Company>BAKA</Company>
    <Product>BAKA Desktop</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>baka.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Now playing (title, artist, album art) comes from Windows' media controls, a WinRT API. The metadata
       ships with Windows 10/11 and the interop assembly with .NET Framework, so nothing extra is installed
       or copied next to the exe. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

</Project>
