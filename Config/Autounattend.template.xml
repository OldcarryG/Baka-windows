<?xml version="1.0" encoding="utf-8"?>
<!--
  BAKA Windows answer file.
  - windowsPE: intentionally absent, so language, edition, and disk selection stay interactive and no disk is erased automatically.
  - specialize: names the PC and registers BAKA's one-time post-OOBE initialization.
  - specialize also creates the local "BAKA" administrator with no password (Enable-AutoSignIn.ps1 -CreateAccount) and registers
    a task that turns on automatic sign-in once OOBE has finished (see Config/AccountSetup.json).
  - oobeSystem: skips the account, privacy, and Microsoft-account screens. Setting a password later restores the sign-in screen.
  Hardware requirements (TPM 2.0, Secure Boot) are not bypassed.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>BAKA-PC</ComputerName>
    </component>
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Create the passwordless BAKA administrator so OOBE skips account creation</Description>
          <Path>cmd.exe /c powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%ProgramData%\BAKA\Scripts\Enable-AutoSignIn.ps1" -CreateAccount</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Description>Register BAKA's one-time post-OOBE initialization</Description>
          <Path>cmd.exe /c powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%ProgramData%\BAKA\Scripts\Register-FirstLogonTask.ps1"</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Description>Register the post-OOBE task that turns on automatic sign-in for the passwordless BAKA account</Description>
          <Path>cmd.exe /c powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%ProgramData%\BAKA\Scripts\Enable-AutoSignIn.ps1" -RegisterTask</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

    </component>
  </settings>
</unattend>
